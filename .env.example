APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://laravel-sample.loc

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=stack
CLOCKWORK_ENABLE=
CLOCKWORK_ARTISAN_COLLECT=1
CLOCKWORK_QUEUE_COLLECT=1
CLOCKWORK_STORAGE_EXPIRATION=1
CLOCKWORK_STORAGE=sql

DB_CONNECTION=pgsql
DB_HOST=postgresql
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

#BROADCAST_CONNECTION=pusher
CACHE_STORE=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=redis

REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

MAIL_MAILER=smtp
MAIL_HOST=laravel-sample-mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
#MAIL_FROM_ADDRESS=
#MAIL_FROM_NAME=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=-
AWS_BUCKET_PUBLIC=sandbox-public
AWS_BUCKET_PRIVATE=sandbox-private
AWS_ENDPOINT=http://seaweedfs:9000
#AWS_URL_PUBLIC=
#AWS_URL_PRIVATE=
AWS_USE_PATH_STYLE_ENDPOINT=true

#PUSHER_APP_ID=1
#PUSHER_APP_KEY=
#PUSHER_APP_SECRET=
#PUSHER_APP_CLUSTER=
#PUSHER_HOST=soketi
#PUSHER_PORT=6001
#PUSHER_SCHEME=http

PULSE_SERVER_NAME=sandbox-node-1

#SENTRY_LARAVEL_DSN=
#SENTRY_TRACES_SAMPLE_RATE=1

ELOQUENT_NOTIFICATION_TELEGRAM_ADAPTER=AnourValar\EloquentNotification\Adapters\Telegram\ExchangerAdapter
#ELOQUENT_NOTIFICATION_TELEGRAM_TOKEN=
#ELOQUENT_NOTIFICATION_TELEGRAM_NAME=

ELOQUENT_NOTIFICATION_SMS_ADAPTER=AnourValar\EloquentNotification\Adapters\Sms\ExchangerAdapter
#ELOQUENT_NOTIFICATION_MTS_TOKEN=
#ELOQUENT_NOTIFICATION_MTS_SENDER=
#ELOQUENT_NOTIFICATION_SMSC_API_TOKEN=
#ELOQUENT_NOTIFICATION_SMSC_SENDER=

ELOQUENT_NOTIFICATION_EXCHANGER_ADAPTER=AnourValar\EloquentNotification\Adapters\Exchanger\MailAdapter
ELOQUENT_NOTIFICATION_MAIL_HOST=laravel-sample-mailpit
ELOQUENT_NOTIFICATION_MAIL_PORT=1025

ELOQUENT_NOTIFICATION_PUSH_ADAPTER=AnourValar\EloquentNotification\Adapters\Push\ExchangerAdapter
